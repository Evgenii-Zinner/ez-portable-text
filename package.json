{
  "name": "ez-portable-text",
  "version": "1.0.0",
  "description": "A lightweight, zero-dependency vanilla JS rich text editor that natively reads and writes Sanity PortableText JSON, optimized for ez-edge-cms.",
  "main": "dist/ez-portable-text.umd.js",
  "module": "dist/ez-portable-text.esm.js",
  "style": "dist/ez-portable-text.umd.css",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w"
  },
  "keywords": [
    "portabletext",
    "editor",
    "vanilla-js",
    "rich-text-editor",
    "ez-edge-cms",
    "sanity",
    "wysiwyg"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "postcss": "^8.4.38",
    "prettier": "^3.8.4",
    "rollup": "^4.18.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "^7.0.2"
  },
  "dependencies": {
    "@portabletext/editor": "^7.5.2",
    "htm": "^3.1.1",
    "preact": "^10.29.2"
  }
}
